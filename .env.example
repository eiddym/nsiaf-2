# Entorno general
NODE_ENV=development

# Base de Datos PostgreSQL
POSTGRES_USER=nsiaf_admin
POSTGRES_PASSWORD=nsiaf_secure_password
POSTGRES_DB=nsiaf_db
DB_PORT=5436

# URL de conexión para Prisma (dentro de docker usa nsiaf_db, fuera usa localhost:5436)
DATABASE_URL="postgresql://nsiaf_admin:nsiaf_secure_password@localhost:5436/nsiaf_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380

# API Backend
API_PORT=3002
JWT_SECRET=nsiaf_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=8h

# Web Frontend
WEB_PORT=8086
API_URL=http://localhost:3002

# Gotenberg (Generador de PDF / Actas)
GOTENBERG_PORT=3004
GOTENBERG_URL=http://localhost:3004

# Interoperabilidad Plantillas
PLANTILLAS_API_URL=http://localhost:8001/api/v1
PLANTILLAS_TOKEN=
